<?xml version="1.0" encoding="utf-8"?>
<!--
  Distribution build.

  The application targets .NET Framework 4.8, which is part of Windows 10 1903+ and Windows 11,
  so nothing has to be bundled or installed: the output is the executable plus the libraries it
  references, about 2.3 MB in total.

  Used by publish.ps1 in the repository root:
      dotnet publish WikiEdits\WikiEdits.csproj -c Release -p:PublishProfile=Dist
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net48</TargetFramework>
    <!-- Program database files are for debugging and are not shipped -->
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
